	</div>
	*@

		<div class="senque-branches__container">

			<!-- Cột trái: giới thiệu -->
			<div class="senque-branches__intro">
				<p class="senque-branches__eyebrow">Hệ thống chi nhánh</p>

				<h2 class="senque-branches__title" id="senque-branches-title">
					<span class="senque-branches__brand">
						Sen Quê
						<svg class="senque-branches__lotus" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
							<path d="M32 4c-6 7-6 19 0 28 6-9 6-21 0-28z" />
							<path d="M32 32c-4-9-11-15-20-17 1 9 9 16 20 17z" />
							<path d="M32 32c4-9 11-15 20-17-1 9-9 16-20 17z" />
							<path d="M32 33c-9-2-18-1-26 4 9 3 18 2 26-4z" />
							<path d="M32 33c9-2 18-1 26 4-9 3-18 2-26-4z" />
