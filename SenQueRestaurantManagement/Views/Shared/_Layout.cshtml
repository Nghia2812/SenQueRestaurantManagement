<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />

	<title>A1 Pharmacy — A pharmacy with time to explain</title>
	<meta name="description" content="An independent community pharmacy. Repeat prescriptions, clinical services and a tightly edited range of everyday health products — with a pharmacist who has time to talk." />
	<meta name="theme-color" content="#1c4032" />
	<link rel="canonical" href="https://example.com/" />

	<meta property="og:site_name" content="A1 Pharmacy" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://example.com/" />
	<meta property="og:title" content="A1 Pharmacy — A pharmacy with time to explain" />
	<meta property="og:description" content="An independent community pharmacy. Repeat prescriptions, clinical services and a tightly edited range of everyday health products — with a pharmacist who has time to talk." />
	<meta name="twitter:card" content="summary" />

	<link rel="icon" href="favicon.svg" type="~/image/svg+xml" />

	<!-- The typeface used by the first line of every page. -->
	<link rel="preload"
		  href="fonts/archivo-latin-wdth-normal.woff2"
		  as="font"
		  type="font/woff2"
		  crossorigin />

	<!-- Shared styles. Page-specific rules follow, so they can override. -->
	<link rel="stylesheet" href="~/css/main.css" />
	<link rel="stylesheet" href="~/css/pages/hero.css" />
	<link rel="stylesheet" href="~/css/pages/home.css" />
	<link rel="stylesheet" href="~/css/pages/senque.css" asp-append-version="true" />
</head>

<body data-full-bleed>
	<div class="page">
		<a href="#main" class="skip-link visually-hidden-focusable">Skip to content</a>

		@RenderBody()

		<footer class="site-footer" data-surface="dark">
			<div class="shell">
				<!-- Newsletter -->
				<div class="newsletter">
					<div data-reveal-on-scroll>
						<p class="label label--light">The dispensary letter</p>
						<h2 class="text-d3 newsletter__title">Seasonal notes from our pharmacists</h2>
						<p class="newsletter__body">
							One letter a month. What is worth taking, what is not, and what we are seeing
							across the counter. No urgency, no discount codes.
						</p>
					</div>

					<div class="newsletter__form-column" data-reveal-on-scroll data-reveal-delay="140">
						<form class="newsletter__form">
							<div class="newsletter__input-wrap">
								<label for="newsletter-email" class="visually-hidden">Email address</label>
								<input id="newsletter-email"
									   name="email"
									   type="email"
									   class="newsletter__input"
									   placeholder="you@example.com"
									   autocomplete="email"
									   required />
							</div>
							<button type="submit" class="button button--light button--lg">
								<span class="button__label">Subscribe</span>
							</button>
						</form>

						<p class="newsletter__note">
							We will never share your address. Unsubscribe in one click.
						</p>

					</div>
				</div>

				<!-- Link columns -->
				<div class="footer-columns">
					<div class="footer-columns__identity">
						<span class="logo logo--light">
							<span class="logo__mark" aria-hidden="true">A1</span>
							<span class="logo__name">Pharmacy</span>
						</span>
						<p class="footer-columns__description">An independent community pharmacy. Repeat prescriptions, clinical services and a tightly edited range of everyday health products — with a pharmacist who has time to talk.</p>

						<address class="footer-columns__address">
							<p>18 Market Street</p>
							<p>Example City 00000</p>
						</address>

						<div class="footer-columns__contact">
							<a href="tel:+0000000000" class="link-rule">+000 0000 0000</a>
							<a href="mailto:hello@a1pharmacy.example" class="link-rule">hello@a1pharmacy.example</a>
						</div>
					</div>

					<div>
						<h3 class="footer-column__heading">Shop</h3>
						<ul class="footer-column__list">
							<li><a href="shop.html" class="footer-column__link">All products</a></li>
							<li><a href="shop.html?category=pain-and-fever" class="footer-column__link">Pain &amp; Fever</a></li>
							<li><a href="shop.html?category=cold-and-flu" class="footer-column__link">Cold &amp; Flu</a></li>
							<li><a href="shop.html?category=allergy-and-hayfever" class="footer-column__link">Allergy &amp; Hayfever</a></li>
							<li><a href="shop.html?category=diagnostics-and-devices" class="footer-column__link">Diagnostics &amp; Devices</a></li>
						</ul>
					</div>
					<div>
						<h3 class="footer-column__heading">Pharmacy</h3>
						<ul class="footer-column__list">
							<li><a class="footer-column__link" data-inert>Repeat prescriptions</a></li>
							<li><a class="footer-column__link" data-inert>Pharmacy First</a></li>
							<li><a class="footer-column__link" data-inert>Travel health</a></li>
							<li><a class="footer-column__link" data-inert>Blood pressure checks</a></li>
							<li><a class="footer-column__link" data-inert>Medicines review</a></li>
						</ul>
					</div>
					<div>
						<h3 class="footer-column__heading">Company</h3>
						<ul class="footer-column__list">
							<li><a class="footer-column__link" data-inert>About us</a></li>
							<li><a class="footer-column__link" data-inert>Our pharmacists</a></li>
							<li><a class="footer-column__link" data-inert>The Journal</a></li>
							<li><a href="contact.html" class="footer-column__link">Contact</a></li>
						</ul>
					</div>
					<div>
						<h3 class="footer-column__heading">Legal</h3>
						<ul class="footer-column__list">
							<li><a class="footer-column__link" data-inert>Privacy policy</a></li>
							<li><a class="footer-column__link" data-inert>Terms of sale</a></li>
							<li><a class="footer-column__link" data-inert>Accessibility</a></li>
							<li><a class="footer-column__link" data-inert>Delivery &amp; returns</a></li>
						</ul>
					</div>
				</div>

				<!-- Opening hours -->
				<div class="footer-hours">
					<div class="footer-hours__slot">
						<p class="footer-hours__days">Monday – Friday</p>
						<p class="footer-hours__time" data-numeric>08:30 – 18:30</p>
					</div>
					<div class="footer-hours__slot">
						<p class="footer-hours__days">Saturday</p>
						<p class="footer-hours__time" data-numeric>09:00 – 17:00</p>
					</div>
					<div class="footer-hours__slot">
						<p class="footer-hours__days">Sunday</p>
						<p class="footer-hours__time" data-numeric>Closed</p>
					</div>
					<div class="footer-hours__slot">
						<p class="footer-hours__days">Bank holidays</p>
						<p class="footer-hours__time" data-numeric>10:00 – 16:00</p>
					</div>
				</div>

				<!-- Regulatory -->
				<div class="footer-legal">
					<p class="footer-legal__statement">
						A1 Pharmacy Ltd is registered with the Pharmacy Regulatory Board
						(premises PH-0000). Superintendent Pharmacist:
						Amara Okonjo, PRB 0000000.
						Registered no. CS-000000000. Tax ID
						C0000000000. Information on this site is general in nature
						and is not a substitute for advice from a healthcare professional. Always read the label.
					</p>

					<div class="footer-legal__meta">
						<p class="footer-legal__copyright">
							© <span data-current-year>2026</span> A1 Pharmacy Ltd.All rights reserve &bull; Distributed by <a href="https://themewagon.com" target="_blank" style="text-decoration: underline; font-weight:bold">ThemeWagon</a>.
						</p>

						<div class="footer-legal__links">
							<a href="https://paragonslash.gumroad.com/l/a1pharmacy?referrer=https%3A%2F%2Fthemes.skylighter.app%2Ffree-edition" rel="noreferrer noopener" target="_blank" class="footer-legal__link">Get the full template — 22 pages</a>
							<a href="#!" class="footer-legal__link" rel="noreferrer noopener">Instagram</a>
							<a href="#!" class="footer-legal__link" rel="noreferrer noopener">Facebook</a>
						</div>
					</div>
				</div>
			</div>
		</footer>

		<!--
				Toasts. The region stays empty until ~/js/toasts.js is called from
				your own code — see A1.toasts.show() in ~/js/toasts.js.
			-->
		<div class="toast-region" data-toast-region role="status" aria-live="polite"></div>
	</div>

	<!--
			Shared scripts, in dependency order. "defer" keeps them off the parser's
			critical path and guarantees they run in the order written.
		-->
	<!--
				Shared scripts. Every one of them looks for its own data-* attributes
				and does nothing if they're not on the page, so the same set works
				unchanged on every page -- there's no dependency order to keep straight.
			-->
	<script src="~/js/toasts.js" defer></script>
	<script src="~/js/add-to-bag.js" defer></script>
	<script src="~/js/header.js" defer></script>
	<script src="~/js/overlays.js" defer></script>
	<script src="~/js/reveal.js" defer></script>
	<script src="~/js/forms.js" defer></script>
	<script src="~/js/slider.js" defer></script>
</body>
</html>
